# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public address of this server (used for PayPal return links and the signup page)
PUBLIC_URL=http://localhost:8787
PORT=8787

# Long random string. Vercel's cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Storage on Vercel: Upstash Redis (the Vercel integration sets KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local storage file when Upstash isn't set
RIOS_DATA_FILE=.data/rios.json

# Money rules
RIOS_FEE_BPS=0
RIOS_CANCEL_WINDOW_HOURS=72
RIOS_MAX_MONTHS=24
